{
  "expo": {
    "name": "JalanKita",
    "slug": "jalankita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jalankita",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "JalanKita membutuhkan akses kamera untuk mengambil foto bukti kerusakan jalan.",
        "NSLocationWhenInUseUsageDescription": "JalanKita mendeteksi lokasi GPS secara otomatis agar laporan akurat.",
        "NSMicrophoneUsageDescription": "JalanKita menggunakan mikrofon untuk input deskripsi berbasis suara (Voice-to-Text)."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E5BF0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1E5BF0"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan JalanKita mengakses kamera untuk memotret jalan rusak."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan JalanKita mendeteksi koordinat GPS laporan Anda."
        }
      ],
      "expo-speech-recognition",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
